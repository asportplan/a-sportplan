# PostgreSQL
POSTGRES_USER=precisetrain
POSTGRES_PASSWORD=precisetrain
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=precisetrain_db
DATABASE_URL=postgresql://precisetrain:precisetrain@localhost:5432/precisetrain_db

# Better Auth
BETTER_AUTH_SECRET=change-this-to-a-random-secret-in-production
BETTER_AUTH_URL=http://localhost:3000

# Server
PORT=3000
NODE_ENV=development

# 9router (AI Proxy Router)
NINEROUTER_URL=http://localhost:20128/v1
NINEROUTER_KEY=your-9router-api-key

# AI coaching (apps/web/api/ai.js) - set in the Vercel project "a-plansport" as well
ANTHROPIC_API_KEY=your-anthropic-api-key
